# ============================================================
# NOVA — Environment Configuration
# ============================================================

NODE_ENV=development

PORT=3000

HOST=0.0.0.0

API_VERSION=v1

CORS_ORIGIN=*

# ============================================================
# Appwrite
# ============================================================

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

APPWRITE_PROJECT_ID=6ac17816000ffd3616a2

APPWRITE_API_KEY=standard_fee3009b6e822cab4d045c31fb94a40572e6918b05e8578fabb97f4a746a3a617e8277f0d2203b0d4245cd08dcb93de0c80f9dcef2185387304d424f8223150608742405074e51217581dc700e730e843a9676eb919f3850ac64cabbc2a4a249665981f59a2b0737a2725328f5c78cac2e4dfa7f8d5c7df9b0abd734c496fbfd

APPWRITE_DATABASE_NAME=NOVA Database

# اتركه فارغًا حاليًا.
# سنجعله يُكتشف تلقائيًا إذا احتجناه.
APPWRITE_DATABASE_ID=

# ============================================================
# Database
# ============================================================

DATABASE_ENABLED=true

DATABASE_DRIVER=appwrite

# ============================================================
# Security
# ============================================================

SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

JWT_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

JWT_EXPIRES_IN=7d

# ============================================================
# Realtime
# ============================================================

REALTIME_ENABLED=false

# ============================================================
# Uploads
# ============================================================

UPLOAD_MAX_SIZE=10485760

UPLOAD_DIRECTORY=uploads

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=info
